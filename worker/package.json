{
  "name": "fling-milestones",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that receives anonymous Fling milestone events and stores them in D1.",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 execute fling-milestones --remote --file=schema.sql",
    "migrate:local": "wrangler d1 execute fling-milestones --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
